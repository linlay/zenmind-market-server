MARKET_ADDR=:8088
MARKET_DB_PATH=data/market.db
MARKET_ARTIFACT_ROOT=data/artifacts
# local keeps development and tests self-contained. Set to s3 in production.
MARKET_ARTIFACT_STORAGE=local
MARKET_S3_BUCKET=
MARKET_S3_REGION=us-east-1
# For COS, MinIO or another S3-compatible service, set the bucket endpoint.
MARKET_S3_ENDPOINT=
MARKET_S3_PREFIX=market
MARKET_S3_ACCESS_KEY_ID=
MARKET_S3_SECRET_ACCESS_KEY=
MARKET_S3_SESSION_TOKEN=
MARKET_S3_PRESIGN_TTL=5m
MARKET_PUBLIC_BASE_URL=https://market.zenmind.cc
MARKET_ADMIN_TOKEN=
MARKET_PROXY_TOKEN=
SSO_JWT_ISSUER=
SSO_JWT_PUBLIC_KEY_FILE=configs/jwt-public.pem
SSO_JWT_PUBLIC_KEY_PEM=
SSO_JWT_AUDIENCE=zenmind-market-server
# OIDC Client mode. Register MARKET_OIDC_REDIRECT_URL with the provider.
MARKET_OIDC_ISSUER=
MARKET_OIDC_CLIENT_ID=
MARKET_OIDC_CLIENT_SECRET=
MARKET_OIDC_REDIRECT_URL=https://market.zenmind.cc/api/v1/auth/oidc/callback
MARKET_OIDC_SESSION_SECRET=
MARKET_OIDC_SCOPES=openid profile email
# Comma-separated staffno or sub values that should receive the Market admin role.
MARKET_OIDC_ADMIN_USER_IDS=
MARKET_OIDC_SUCCESS_REDIRECT=/
# Development only. Logs verified ID Token claims after sensitive fields are redacted.
MARKET_OIDC_DEBUG_CLAIMS=false
# Development only. Never enable in production.
MARKET_ENABLE_LOCAL_AUTH=false
MARKET_MAX_UPLOAD_BYTES=536870912
